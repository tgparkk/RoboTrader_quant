{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(psql:*)",
      "Bash(python:*)",
      "Bash(timeout 30 python:*)",
      "Bash(timeout 15 python:*)",
      "Bash(PYTHONIOENCODING=utf-8 python:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(set:*)",
      "Bash(chcp:*)",
      "Bash(pip show:*)",
      "Bash(tasklist:*)",
      "Bash(powershell -Command:*)",
      "Bash(cd:*)",
      "Bash(iconv:*)"
    ],
    "deny": [],
    "ask": []
  }
}
